{
  "name": "meeting-copilot",
  "version": "0.1.0",
  "description": "Private meeting copilot: detects meetings, listens, answers questions in a capture-protected overlay",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prep": "node src/prep.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win",
    "test": "node --test tests/license.test.js",
    "license:make": "node tools/license.js make"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "author": "Meeting Copilot",
  "build": {
    "appId": "com.meetingcopilot.app",
    "productName": "Meeting Copilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "overlay/**/*",
      "settings/**/*",
      "build/icon.png",
      "package.json",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "build/icon.png"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": ".models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Meeting Copilot",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "build/afterPack.js"
  },
  "buyUrl": ""
}
