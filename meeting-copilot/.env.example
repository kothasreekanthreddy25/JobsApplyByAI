ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Used ONLY when your documents have no good match (leave blank to use Claude for those too)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Fast model keeps first token < 1s
ANSWER_MODEL=claude-haiku-5-5
# Optional: private ICS calendar URL (Google Calendar "Secret address in iCal format", Outlook publish link)
CALENDAR_ICS_URL=
# Folder with general reference docs (.txt/.md). Per-meeting docs: docs/<meeting title keyword>/
DOCS_DIR=./docs
